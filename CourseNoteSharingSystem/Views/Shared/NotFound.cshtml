@{
    ViewData["Title"] = "Not Found";
}

<div class="container py-5">
    <section class="glass-card p-5 text-center">
        <span class="eyebrow">404</span>
        <h1 class="section-title mt-3">Page not found</h1>
        <p class="text-muted mx-auto" style="max-width:620px;">The page you are looking for may have moved, or the note may no longer be available.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Back to home</a>
    </section>
</div>
