<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Course Note Sharing</title>
    <meta name="description" content="Share and discover course notes online. A modern platform for students." />
    <script type="importmap"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CourseNoteSharingSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-premium">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-journal-richtext me-2" style="font-size:1.4rem;"></i>
                CourseNotes
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Notes" asp-action="Index">
                            <i class="bi bi-file-earmark-text me-1"></i> Notes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Courses" asp-action="Index">
                            <i class="bi bi-book me-1"></i> Courses
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center gap-2">
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="btn btn-nav-accent" asp-area="" asp-controller="Home" asp-action="SignUp">
                                <i class="bi bi-person-plus me-1"></i> Join
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-nav-outline" asp-area="" asp-controller="Home" asp-action="SignIn">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                            </a>
                        </li>
                    }
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link" style="color:rgba(255,255,255,0.7) !important;">
                                <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-nav-outline" asp-area="" asp-controller="Home" asp-action="SignOut">
                                <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-premium">
        <div class="container">
            <div class="footer-brand">
                <i class="bi bi-journal-richtext me-1"></i> CourseNotes
            </div>
            <p class="mb-1">&copy; 2026 Course Note Sharing System. All rights reserved.</p>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">
                <i class="bi bi-shield-check me-1"></i> Privacy Policy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
