@{
    var displayName = User.Identity?.Name ?? "U";
    var avatarLetter = displayName.Length > 0 ? displayName.Substring(0, 1).ToUpperInvariant() : "U";
}
<header class="app-navbar navbar navbar-expand-lg sticky-top">
    <div class="container-fluid">
        <button class="btn icon-btn d-lg-none me-2" type="button" data-sidebar-toggle aria-label="Open menu">
            <i class="bi bi-list"></i>
        </button>
        <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
            <span class="brand-mark"><i class="bi bi-journal-richtext"></i></span>
            <span>CourseNotes</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <nav class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Notes" asp-action="Index">Notes</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Notes" asp-action="Create">Upload</a></li>
                }
            </ul>
            <div class="navbar-actions">
                <button class="btn icon-btn" type="button" data-theme-toggle aria-label="Toggle theme">
                    <i class="bi bi-moon-stars"></i>
                </button>
                <div class="dropdown">
                    <button class="btn icon-btn position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
                        <i class="bi bi-bell"></i>
                        <span class="notification-dot"></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end app-dropdown p-2">
                        <div class="dropdown-header fw-semibold">Notifications</div>
                        <div class="notification-item">New uploads wait for review.</div>
                        <div class="notification-item">Your dashboard is ready.</div>
                    </div>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="btn user-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar">@avatarLetter</span>
                            <span class="d-none d-sm-inline">@displayName</span>
                            <i class="bi bi-chevron-down small"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end app-dropdown">
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item" asp-controller="AdminDashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" asp-controller="UserDashboard" asp-action="Index"><i class="bi bi-grid me-2"></i>Dashboard</a></li>
                            }
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" asp-controller="Home" asp-action="SignOut"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-ghost" asp-controller="Home" asp-action="SignIn">Sign in</a>
                    <a class="btn btn-primary" asp-controller="Home" asp-action="SignUp">Join free</a>
                }
            </div>
        </nav>
    </div>
</header>
