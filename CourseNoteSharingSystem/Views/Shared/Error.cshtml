@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <section class="glass-card p-5 text-center">
        <i class="bi bi-exclamation-triangle display-3 text-primary"></i>
        <h1 class="section-title mt-4">Something went wrong</h1>
        <p class="text-muted mx-auto" style="max-width:620px;">The request could not be completed. You can return home or try the previous action again.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
        }
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go home</a>
            <a asp-controller="Notes" asp-action="Index" class="btn btn-ghost">Open notes</a>
        </div>
    </section>
</div>
