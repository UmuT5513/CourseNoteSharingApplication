@model IEnumerable<CourseNoteSharingSystem.Models.Note>

@{
    ViewData["Title"] = "Notes";
    Layout = "_Layout";
}

<div class="container page-container">
    <!-- Page Title -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h1 class="section-title mb-1"><i class="bi bi-file-earmark-text me-2 text-gradient"></i>Course Notes</h1>
            <div class="divider"></div>
        </div>
        <a asp-action="Create" class="btn btn-gradient">
            <i class="bi bi-cloud-upload me-2"></i> Upload New Note
    </a>
</div>

    <!-- Search Bar -->
    <form method="get" class="search-bar">
        <div class="row g-3 align-items-center">
            <div class="col-md-5">
                <input type="text" name="search" value="@Context.Request.Query["search"]"
                       class="form-control" placeholder="🔍 Search by title..." />
        </div>

        <div class="col-md-3">
                <select name="sortOrder" class="form-select" style="border-radius:50px;">
                    <option value="">📅 Newest</option>
                    <option value="downloads">📥 Most Downloaded</option>
            </select>
        </div>

        <div class="col-md-2">
                <button type="submit" class="btn btn-gradient w-100">
                    <i class="bi bi-search me-1"></i> Search
            </button>
        </div>

    </div>

</form>

@if (!Model.Any())
{
        <div class="empty-state">
            <i class="bi bi-journal-x"></i>
            <h5>No notes found</h5>
            <p>Try a different search or upload the first note!</p>
    </div>
}

    <div class="row g-4">
    @foreach (var item in Model)
    {
            <div class="col-md-6">
                <div class="card-premium h-100">
                <div class="card-body">

                    <h4 class="card-title">
                            <i class="bi bi-file-earmark-text me-2" style="color:var(--primary);"></i>@item.Title
                    </h4>
                        <p class="card-text">@item.Description</p>
                        <div class="d-flex flex-wrap gap-3 mb-2" style="font-size:0.88rem;">
                            <span class="text-muted"><i class="bi bi-calendar3 me-1"></i> @item.UploadDate.ToShortDateString()</span>
                            <span class="text-muted"><i class="bi bi-download me-1"></i> @item.DownloadCount downloads</span>
                        </div>
                    @if (item.Course != null)
                    {
                            <span class="badge-premium badge-approved"><i class="bi bi-book me-1"></i> @item.Course.CourseName</span>
                    }

                    @if (item.User != null)
                    {
                            <span class="badge bg-light text-dark ms-1" style="font-size:0.78rem;border-radius:50px;padding:0.3rem 0.7rem;">
                                <i class="bi bi-person me-1"></i> @item.User.UserName
                            </span>
                    }

                </div>
                    <div class="card-footer d-flex flex-wrap gap-2">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-gradient btn-sm">
                            <i class="bi bi-eye me-1"></i> Details
                    </a>
                        <a asp-action="Download" asp-route-id="@item.Id" class="btn btn-success-premium btn-sm">
                            <i class="bi bi-download me-1"></i> Download
                    </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning-premium btn-sm">
                            <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger-premium btn-sm">
                            <i class="bi bi-trash me-1"></i> Delete
                    </a>

                </div>

            </div>

        </div>
    }
    </div>
</div>