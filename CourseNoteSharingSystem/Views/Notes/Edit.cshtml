@model CourseNoteSharingSystem.Models.Note
@{
    ViewData["Title"] = "Edit Note";
}

<section class="notes-header glass-card">
    <span class="eyebrow">Edit note</span>
    <h1 class="section-title mb-2">@Model.Title</h1>
    <p class="text-muted mb-0">Update metadata while preserving the existing uploaded file path.</p>
</section>

<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="Edit" class="soft-card p-4">
            <div asp-validation-summary="ModelOnly"></div>
            <input type="hidden" asp-for="Id" />

            <label asp-for="Title" class="form-label fw-semibold">Title</label>
            <input asp-for="Title" class="form-control mb-2" />
            <span asp-validation-for="Title" class="text-danger small"></span>

            <label asp-for="Description" class="form-label fw-semibold mt-3">Description</label>
            <textarea asp-for="Description" class="form-control mb-2" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>

            <label asp-for="FilePath" class="form-label fw-semibold mt-3">File path</label>
            <input asp-for="FilePath" class="form-control mb-2" />
            <span asp-validation-for="FilePath" class="text-danger small"></span>

            <label asp-for="UploadDate" class="form-label fw-semibold mt-3">Upload date</label>
            <input asp-for="UploadDate" class="form-control mb-2" />
            <span asp-validation-for="UploadDate" class="text-danger small"></span>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-check2 me-2"></i>Save changes</button>
                <a asp-action="Index" class="btn btn-ghost btn-lg">Back to list</a>
            </div>
        </form>
    </div>
    <aside class="col-lg-5">
        <div class="preview-panel">
            <div class="text-center p-4">
                <i class="bi bi-file-earmark-text display-4 text-primary"></i>
                <h2 class="h5 fw-bold mt-3">Current file</h2>
                <p class="text-muted">@Model.FilePath</p>
            </div>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
