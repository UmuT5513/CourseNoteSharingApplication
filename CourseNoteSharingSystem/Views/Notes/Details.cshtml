@model Note
@{
    ViewData["Title"] = Model.Title;
    var ext = (System.IO.Path.GetExtension(Model.FilePath ?? "") ?? ".file").Trim('.').ToUpperInvariant();
    var isPdf = ext == "PDF";
}

<section class="notes-header glass-card">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <span class="eyebrow">Note details</span>
            <h1 class="section-title mb-2">@Model.Title</h1>
            <p class="text-muted mb-0">@Model.Description</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-download me-2"></i>Download</a>
            <button class="btn btn-ghost" type="button"><i class="bi bi-heart me-2"></i>Favorite</button>
        </div>
    </div>
</section>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="soft-card p-3 p-md-4">
            <div class="panel-header">
                <h2 class="h5 fw-bold mb-0">Preview</h2>
                <span class="file-badge"><i class="bi bi-file-earmark"></i>@ext</span>
            </div>
            <div class="preview-panel">
                @if (isPdf)
                {
                    <iframe src="@Model.FilePath" title="@Model.Title preview"></iframe>
                }
                else
                {
                    <div class="text-center p-4">
                        <i class="bi bi-file-earmark-arrow-down display-4 text-primary"></i>
                        <h3 class="h5 fw-bold mt-3">Preview is not available for @ext files</h3>
                        <p class="text-muted">Download the file to view it on your device.</p>
                    </div>
                }
            </div>
        </div>
    </div>
    <aside class="col-lg-4">
        <div class="soft-card p-4 mb-4">
            <h2 class="h5 fw-bold mb-3">Document info</h2>
            <div class="d-grid gap-3">
                <div><span class="text-muted">Course</span><strong class="d-block">@(Model.Course?.CourseName ?? "Unassigned")</strong></div>
                <div><span class="text-muted">Uploaded by</span><strong class="d-block">@(Model.User?.UserName ?? "Unknown")</strong></div>
                <div><span class="text-muted">Upload date</span><strong class="d-block">@Model.UploadDate.ToString("MMM dd, yyyy")</strong></div>
                <div><span class="text-muted">Downloads</span><strong class="d-block">@Model.DownloadCount</strong></div>
                <div><span class="text-muted">Status</span><strong class="d-block">@Model.Status</strong></div>
            </div>
        </div>
        <div class="soft-card p-4">
            <h2 class="h5 fw-bold mb-3">Actions</h2>
            <div class="d-grid gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-ghost"><i class="bi bi-pencil me-2"></i>Edit note</a>
                <a asp-action="Index" class="btn btn-ghost"><i class="bi bi-arrow-left me-2"></i>Back to list</a>
            </div>
        </div>
    </aside>
</div>

<section class="soft-card p-4 mt-4">
    <div class="panel-header">
        <h2 class="h5 fw-bold mb-0">Comments</h2>
        <span class="badge text-bg-light text-dark">@(Model.Comments?.Count ?? 0)</span>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-action="AddComment" method="post" class="mb-4">
            <input type="hidden" name="noteId" value="@Model.Id" />
            <textarea name="content" class="form-control mb-3" placeholder="Write a thoughtful comment..." rows="3"></textarea>
            <button type="submit" class="btn btn-primary"><i class="bi bi-send me-2"></i>Add comment</button>
        </form>
    }

    @if (Model.Comments == null || !Model.Comments.Any())
    {
        <div class="empty-state"><div><i class="bi bi-chat-left-text"></i><p class="mt-3 mb-0">No comments yet.</p></div></div>
    }
    else
    {
        <div class="d-grid gap-3">
            @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
            {
                <article class="comment-card">
                    <div class="d-flex justify-content-between gap-3">
                        <strong>@comment.User?.UserName</strong>
                        <small class="text-muted">@comment.CreatedAt.ToString("g")</small>
                    </div>
                    <p class="mb-0 mt-2">@comment.Content</p>
                </article>
            }
        </div>
    }
</section>
