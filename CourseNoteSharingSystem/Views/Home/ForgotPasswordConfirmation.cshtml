@{
    Layout = "_Layout";
    ViewData["Title"] = "Password Reset Link";
}

<div class="auth-wrapper">
    <div class="auth-card text-center">
        <div class="auth-icon" style="background:linear-gradient(135deg, #00b894, #00cec9);">
            <i class="bi bi-check-lg"></i>
        </div>
        <h2>Check Your Email</h2>
        <p class="auth-subtitle">Password reset key has been created.</p>

        <div class="alert alert-success" style="border-radius:var(--radius-md);">
            <i class="bi bi-envelope-check me-2"></i> Please check your mail box!
        </div>

        <a asp-action="ResetPassword"
           asp-route-token="@ViewBag.Token"
           asp-route-email="@ViewBag.Email"
           class="btn btn-accent w-100 py-2" style="border-radius:var(--radius-sm);">
            <i class="bi bi-pencil-square me-2"></i> Set New Password
        </a>
    </div>
</div>