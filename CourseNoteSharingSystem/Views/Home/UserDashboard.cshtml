@using CourseNoteSharingSystem.ViewModels
@{
    Layout = "_Layout";
}

@model List<UserWithRolesViewModel>


<h2>User Dashboard</h2>

<h2> User List</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>User Name</th>
            <th>Email</th>
            <th>Roles</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@string.Join(", ", user.Roles)</td>
            </tr>
        }
    </tbody>
</table>


