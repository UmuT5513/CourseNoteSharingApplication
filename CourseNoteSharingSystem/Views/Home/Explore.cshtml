@model IEnumerable<CourseNoteSharingSystem.Models.Note>

<div class="container py-4">
    <div class="row align-items-end mb-4 g-3">
        <div class="col-lg-8">
            <h1 class="mb-2">Explore Notes</h1>
            <p class="text-muted mb-0">Search, browse, and download the latest shared notes.</p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-dark">
                        My Dashboard (Admin)
                    </a>
                }
                else
                {
                    <a asp-controller="UserDashboard" asp-action="Index" class="btn btn-dark">
                        My Dashboard
                    </a>
                }
                <a asp-controller="Notes" asp-action="Create" class="btn btn-primary">
                    Upload Note
                </a>
            </div>
        </div>
    </div>

    <form asp-controller="Notes" asp-action="Index" method="get" class="mb-5">
        <div class="input-group input-group-lg shadow-sm">
            <input type="text" name="search" class="form-control" placeholder="Search notes..." />
            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Recent Notes</h2>
        <span class="badge bg-secondary">@Model.Count() notes</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">No recent notes found.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var note in Model)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body d-flex flex-column">
                            <h4 class="card-title">@note.Title</h4>
                            <p class="card-text text-muted">@note.Description</p>

                            @if (note.Course != null)
                            {
                                <p class="mb-1"><strong>Course:</strong> @note.Course.CourseName</p>
                            }

                            @if (note.User != null)
                            {
                                <p class="mb-1"><strong>Uploaded By:</strong> @note.User.UserName</p>
                            }

                            <p class="mb-1"><strong>Upload Date:</strong> @note.UploadDate.ToShortDateString()</p>
                            <p class="mb-3"><strong>Downloads:</strong> @note.DownloadCount</p>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-controller="Notes" asp-action="Details" asp-route-id="@note.Id" class="btn btn-primary btn-sm">
                                    Details
                                </a>
                                <a asp-controller="Notes" asp-action="Download" asp-route-id="@note.Id" class="btn btn-success btn-sm">
                                    Download
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <hr class="my-5" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Popular Notes</h2>
    </div>

    @{
        var popularNotes = ViewBag.PopularNotes as IEnumerable<CourseNoteSharingSystem.Models.Note>;
    }

    @if (popularNotes == null || !popularNotes.Any())
    {
        <div class="alert alert-warning">No popular notes found.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var note in popularNotes)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 border-success">
                        <div class="card-body d-flex flex-column">
                            <h4 class="card-title">@note.Title</h4>
                            <p class="card-text text-muted">@note.Description</p>

                            @if (note.Course != null)
                            {
                                <p class="mb-1"><strong>Course:</strong> @note.Course.CourseName</p>
                            }

                            <p class="mb-3"><strong>Downloads:</strong> @note.DownloadCount</p>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-controller="Notes" asp-action="Details" asp-route-id="@note.Id" class="btn btn-primary btn-sm">
                                    Details
                                </a>
                                <a asp-controller="Notes" asp-action="Download" asp-route-id="@note.Id" class="btn btn-success btn-sm">
                                    Download
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
