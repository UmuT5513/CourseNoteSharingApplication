@{
    Layout = "_Layout";
    ViewData["Title"] = "Privacy Policy";
}

<div class="container page-container">
    <div class="form-card" style="max-width:700px;">
        <div class="text-center mb-4">
            <div class="auth-icon mx-auto" style="background:linear-gradient(135deg, #00b894, #00cec9);width:60px;height:60px;font-size:1.5rem;">
                <i class="bi bi-shield-check"></i>
            </div>
            <h2 class="mt-3 text-gradient">Privacy Policy</h2>
        </div>
        <p class="text-muted" style="line-height:1.8;">
            This application is a course note sharing platform. Your personal data is securely stored and will not be shared with third parties.
            We take your privacy seriously and implement appropriate security measures to protect your information.
        </p>
    </div>
</div>
