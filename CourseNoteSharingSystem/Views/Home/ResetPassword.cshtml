@using CourseNoteSharingSystem.ViewModels
@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container py-4">
    <section class="auth-shell">
        <div class="auth-visual">
            <div class="auth-visual-content">
                <span class="eyebrow text-white">New password</span>
                <h1 class="mt-3">Choose a fresh password for your notes library.</h1>
                <p class="mt-3">Keep your account secure before returning to uploads and comments.</p>
            </div>
        </div>
        <div class="auth-card glass-card">
            <span class="eyebrow">Secure update</span>
            <h2 class="mt-2 mb-2">Reset password</h2>
            <p class="text-muted mb-4">Set a new password for <strong>@Model.Email</strong>.</p>
            <form asp-action="ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly"></div>
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <label asp-for="Password" class="form-label fw-semibold">New password</label>
                <div class="floating-field">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password" type="password" class="form-control pe-5" autocomplete="new-password" />
                    <button class="password-toggle" type="button" data-password-toggle aria-label="Show password"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>

                <label asp-for="ConfirmPassword" class="form-label fw-semibold mt-3">Confirm password</label>
                <div class="floating-field">
                    <i class="bi bi-shield-check"></i>
                    <input asp-for="ConfirmPassword" type="password" class="form-control pe-5" autocomplete="new-password" />
                    <button class="password-toggle" type="button" data-password-toggle aria-label="Show password"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>

                <button type="submit" class="btn btn-primary w-100 btn-lg mt-3">Update password</button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
