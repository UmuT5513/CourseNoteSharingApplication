@using CourseNoteSharingSystem.ViewModels
@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Yeni Şifre Belirle";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Reset Password</h4>
                </div>
                <div class="card-body">
                    <form asp-action="ResetPassword" method="post">
                        <!-- Validasyon hatalarını burada gösteririz -->
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- KRİTİK: Token ve Email gizli input olarak gönderilmeli -->
                        <input type="hidden" asp-for="Token" />
                        <input type="hidden" asp-for="Email" />

                        <div class="form-group mb-3">
                            <label asp-for="Email" class="form-label font-weight-bold">E-mail</label>
                            <input asp-for="Email" class="form-control" disabled />
                            <!-- Email'i görsel olarak gösteriyoruz ama 'disabled' olduğu için POST edilmez,
                                 yukarıdaki 'hidden' input asıl veriyi taşır. -->
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Password" class="form-label font-weight-bold">New Password</label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="ConfirmPassword" class="form-label font-weight-bold">Confirm New Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="New password again" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg">Update Password</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Client-side validasyon (sayfa yenilenmeden hata kontrolü) -->
    <partial name="_ValidationScriptsPartial" />
}