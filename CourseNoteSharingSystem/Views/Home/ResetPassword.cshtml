@using CourseNoteSharingSystem.ViewModels
@model ResetPasswordViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Reset Password";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-icon">
            <i class="bi bi-shield-lock"></i>
                </div>
        <h2>Reset Password</h2>
        <p class="auth-subtitle">Create a new password for your account</p>

                    <form asp-action="ResetPassword" method="post">
                        <!-- Validasyon hatalarını burada gösteririz -->
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- KRİTİK: Token ve Email gizli input olarak gönderilmeli -->
                        <input type="hidden" asp-for="Token" />
                        <input type="hidden" asp-for="Email" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label"><i class="bi bi-envelope me-1"></i> Email</label>
                            <input asp-for="Email" class="form-control" disabled />
                            <!-- Email'i görsel olarak gösteriyoruz ama 'disabled' olduğu için POST edilmez,
                                 yukarıdaki 'hidden' input asıl veriyi taşır. -->
                        </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"><i class="bi bi-lock me-1"></i> New Password</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Enter new password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"><i class="bi bi-lock-fill me-1"></i> Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirm new password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

            <button type="submit" class="btn btn-success-premium w-100 py-2" style="border-radius:var(--radius-sm);">
                <i class="bi bi-check-circle me-2"></i> Update Password
            </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Client-side validasyon (sayfa yenilenmeden hata kontrolü) -->
    <partial name="_ValidationScriptsPartial" />
}