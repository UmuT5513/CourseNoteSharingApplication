@model SignInModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-4">
    <section class="auth-shell">
        <div class="auth-visual">
            <div class="auth-visual-content">
                <span class="eyebrow text-white">Student workspace</span>
                <h1 class="mt-3">Sign in and continue sharing better notes.</h1>
                <p class="mt-3">A clean, focused place for course materials, downloads, comments and approvals.</p>
            </div>
            <div class="auth-metric-row">
                <div class="auth-metric"><strong>PDF</strong><span>Preview ready</span></div>
                <div class="auth-metric"><strong>50MB</strong><span>Upload limit</span></div>
                <div class="auth-metric"><strong>24/7</strong><span>Course access</span></div>
            </div>
        </div>

        <div class="auth-card glass-card">
            <span class="eyebrow">Welcome back</span>
            <h2 class="mt-2 mb-2">Sign in</h2>
            <p class="text-muted mb-4">Use your username and password to access your dashboard.</p>

            <form asp-action="SignIn" method="post" novalidate>
                <div asp-validation-summary="All"></div>

                <label asp-for="UserName" class="form-label fw-semibold">Username</label>
                <div class="floating-field">
                    <i class="bi bi-person"></i>
                    <input asp-for="UserName" class="form-control" autocomplete="username" placeholder="your username" />
                </div>
                <span asp-validation-for="UserName" class="text-danger small"></span>

                <label asp-for="Password" class="form-label fw-semibold mt-3">Password</label>
                <div class="floating-field">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password" type="password" class="form-control pe-5" autocomplete="current-password" placeholder="your password" />
                    <button class="password-toggle" type="button" data-password-toggle aria-label="Show password"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>

                <div class="d-flex align-items-center justify-content-between gap-3 my-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="RememberMe" />
                        <label class="form-check-label" asp-for="RememberMe">Remember me</label>
                    </div>
                    <a asp-action="ForgotPassword" asp-controller="Home">Forgot password?</a>
                </div>

                <button type="submit" class="btn btn-primary w-100 btn-lg">Sign in</button>
                <p class="text-center text-muted mt-4 mb-0">
                    New here? <a asp-action="SignUp" asp-controller="Home" class="fw-semibold">Create an account</a>
                </p>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
