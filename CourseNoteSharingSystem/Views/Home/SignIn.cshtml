@using CourseNoteSharingSystem.ViewModels
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign In";
}
@model SignInModel

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-icon">
            <i class="bi bi-box-arrow-in-right"></i>
        </div>
        <h2>Welcome Back</h2>
        <p class="auth-subtitle">Sign in to access your notes</p>

        <form asp-action="SignIn" method="post">
            <div asp-validation-summary="All" class="alert alert-danger" role="alert" style="display:none;"></div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label"><i class="bi bi-person me-1"></i> Username</label>
                <input asp-for="UserName" class="form-control" placeholder="Enter your username" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"><i class="bi bi-lock me-1"></i> Password</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" asp-for="RememberMe" />
                <label class="form-check-label" asp-for="RememberMe">Remember me</label>
            </div>

            <button type="submit" class="btn btn-gradient w-100 py-2 mb-3">
                <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
            </button>

            <div class="text-center">
                <a asp-action="ForgotPassword" asp-controller="Home" class="text-muted small">
                    <i class="bi bi-key me-1"></i> Forgot Password?
                </a>
            </div>

            <hr />

            <div class="text-center d-flex flex-column gap-1 align-items-center">
                <span class="text-muted small">
                    <a asp-action="DontYouHaveAnAccount" asp-controller="Home">Don't have an account?</a>
                </span>
                <a asp-action="SignUp" asp-controller="Home" class="small fw-semibold">Sign Up</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        var summary = document.querySelector('[data-valmsg-summary]') || document.querySelector('.alert-danger');
        if (summary && summary.textContent.trim().length > 0 && summary.querySelector('li')) {
            summary.style.display = 'block';
        }
    </script>
}
