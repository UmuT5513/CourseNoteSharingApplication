
@{
    Layout = "_Layout";
    ViewData["Title"] = "Access Denied";
}

<div class="auth-wrapper">
    <div class="auth-card text-center">
        <div class="auth-icon" style="background:linear-gradient(135deg, #ff6b6b, #ee5a24);">
            <i class="bi bi-shield-x"></i>
        </div>
        <h2>Access Denied</h2>
        <p class="auth-subtitle">You don't have permission to access this page.</p>

        <a asp-action="Index" asp-controller="Home" class="btn btn-gradient w-100 py-2" style="border-radius:var(--radius-sm);">
            <i class="bi bi-house me-2"></i> Go to Home
        </a>
    </div>
</div>
