@{
    Layout = "_Layout";
    ViewData["Title"] = "Password Reset Successful";
}

<div class="auth-wrapper">
    <div class="auth-card text-center">
        <div class="auth-icon" style="background:linear-gradient(135deg, #00b894, #00cec9);">
            <i class="bi bi-check-circle"></i>
        </div>
        <h2>Success!</h2>
        <p class="auth-subtitle">Your password has been reset successfully.</p>

        <div class="alert alert-success" style="border-radius:var(--radius-md);">
            <i class="bi bi-shield-check me-2"></i> You can now log in with your new password.
        </div>

        <a asp-action="SignIn" asp-controller="Home" class="btn btn-gradient w-100 py-2" style="border-radius:var(--radius-sm);">
            <i class="bi bi-box-arrow-in-right me-2"></i> Go to Sign In
        </a>
    </div>
</div>