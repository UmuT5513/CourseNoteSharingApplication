@{
    ViewData["Title"] = "Şifre Değiştirildi";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="alert alert-success">
                <h4 class="alert-heading">Success!</h4>
                <p>Your password has been reset successfully.</p>
                <hr>
                <p class="mb-0">You can now log in with your new password.</p>
            </div>

            <div class="mt-4">
                <!-- Buradaki 'Login' ve 'Account' kısımlarını kendi yapına göre düzenle -->
                <a asp-action="SignIn" asp-controller="Home" class="btn btn-primary">
                    Go to Sign In
                </a>
            </div>
        </div>
    </div>
</div>