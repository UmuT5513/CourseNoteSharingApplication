@using CourseNoteSharingSystem.ViewModels
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-4">
    <section class="auth-shell">
        <div class="auth-visual">
            <div class="auth-visual-content">
                <span class="eyebrow text-white">Account recovery</span>
                <h1 class="mt-3">Recover access without losing your workspace.</h1>
                <p class="mt-3">Enter your email address and continue with the generated reset flow.</p>
            </div>
        </div>
        <div class="auth-card glass-card">
            <span class="eyebrow">Reset access</span>
            <h2 class="mt-2 mb-2">Forgot password?</h2>
            <p class="text-muted mb-4">We will verify the email address registered on your account.</p>
            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly"></div>
                <label asp-for="Email" class="form-label fw-semibold">Email address</label>
                <div class="floating-field">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
                <button type="submit" class="btn btn-primary w-100 btn-lg mt-3">Send reset link</button>
                <a asp-action="SignIn" class="btn btn-ghost w-100 mt-3">Back to sign in</a>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
