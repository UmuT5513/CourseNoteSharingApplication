@{
    ViewData["Title"] = "Home Page";
    Layout = "_Layout";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7 fade-in">
                <span class="badge rounded-pill bg-white text-dark px-3 py-2 mb-3 shadow-sm" style="font-weight:600;">
                    <i class="bi bi-stars text-warning me-1"></i> Course Note Sharing System
                </span>
                <h1 class="hero-title">Online Learning<br/>Platform</h1>
                <p class="hero-subtitle">
                    Ders notlarını paylaş, keşfet ve birlikte öğren.<br/>
                    Notlarını düzenli bir şekilde yükle ve arkadaşlarınla paylaş.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-accent btn-lg px-4" asp-controller="Home" asp-action="SignUp" style="border-radius:50px;">
                        <i class="bi bi-rocket-takeoff me-2"></i> Join For Free
                    </a>
                    <a class="btn btn-glass btn-lg" asp-controller="Notes" asp-action="Index">
                        <i class="bi bi-eye me-2"></i> Notlara Göz At
                    </a>
                </div>
            </div>
            <div class="col-lg-5 fade-in fade-in-delay-2">
                <div class="glass-panel">
                    <div class="d-flex align-items-center mb-3">
                        <div style="width:56px;height:56px;border-radius:16px;display:grid;place-items:center;background:rgba(255,255,255,0.2);font-size:1.4rem;font-weight:700;margin-right:1rem;">
                            <i class="bi bi-journal-check"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 fw-bold">Akıllı Not Deneyimi</h5>
                            <p class="mb-0 opacity-75" style="font-size:0.9rem;">Hızlı erişim, temiz görünüm, modern arayüz.</p>
                        </div>
                    </div>
                    <ul class="list-unstyled mb-0" style="opacity:0.9;">
                        <li class="mb-2"><i class="bi bi-check-circle-fill me-2 text-warning"></i> Ders notlarını kolayca keşfet</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill me-2 text-warning"></i> Paylaşım ve erişimi hızlandır</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill me-2 text-warning"></i> Not yükle, yorum yap, indir</li>
                        <li><i class="bi bi-check-circle-fill me-2 text-warning"></i> Admin onay sistemi</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Feature Cards -->
<section class="feature-cards-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4 fade-in fade-in-delay-1">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-book-half"></i>
                    </div>
                    <h5>Ders Kursları</h5>
                    <p>Farklı bölümlerden kursları keşfet ve notları organize bir şekilde takip et.</p>
                </div>
            </div>
            <div class="col-md-4 fade-in fade-in-delay-2">
                <div class="feature-card">
                    <div class="feature-icon" style="background:linear-gradient(135deg,rgba(255,107,53,0.12),rgba(253,203,110,0.12));color:#FF6B35;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h5>Uzman Öğrenciler</h5>
                    <p>Topluluktaki öğrencilerin paylaştığı kaliteli notlara kolayca ulaş.</p>
                </div>
            </div>
            <div class="col-md-4 fade-in fade-in-delay-3">
                <div class="feature-card">
                    <div class="feature-icon" style="background:linear-gradient(135deg,rgba(0,184,148,0.12),rgba(0,206,201,0.12));color:#00b894;">
                        <i class="bi bi-infinity"></i>
                    </div>
                    <h5>Ömür Boyu Erişim</h5>
                    <p>Yüklenen notlar arşivde kalır. İstediğin zaman geri dön ve indir.</p>
                </div>
            </div>
        </div>
    </div>
</section>
