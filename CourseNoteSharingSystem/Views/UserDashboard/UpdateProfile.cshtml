@using CourseNoteSharingSystem.ViewModels
@{
    Layout = "_Layout";
}

@model UpdateProfileViewModel

<form asp-action="UpdateProfile" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="container page-container">
        <div class="page-header mb-4">
            <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h2 class="mb-1">Update Profile</h2>
                    <p class="mb-0">Edit your personal information and contact details.</p>
                </div>
                <span class="badge badge-premium bg-secondary">Profile Settings</span>
            </div>
        </div>

        <div class="form-card">
            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Bio" class="form-label">Bio</label>
                    <input asp-for="Bio" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="LinkedInProfileLink" class="form-label">LinkedIn Profile</label>
                    <input asp-for="LinkedInProfileLink" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="OgrenciMail" class="form-label">Student Mail</label>
                    <input asp-for="OgrenciMail" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="OgrenciNumarasi" class="form-label">Student Number</label>
                    <input asp-for="OgrenciNumarasi" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-gradient px-4">
                        Save Changes
                    </button>
                    <a asp-controller="UserDashboard" asp-action="SummaryProfile" class="btn btn-outline-premium px-4">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

