@using CourseNoteSharingSystem.ViewModels

@{
    Layout = "_Layout";
    ViewData["Title"] = "My Dashboard";
}

@model UserDashboardViewModel

<div class="container page-container">
    <div class="d-flex justify-content-between align-items-center mb-2">
    <div>
            <h1 class="section-title mb-1"><i class="bi bi-person-workspace me-2 text-gradient"></i>My Dashboard</h1>
            <div class="divider"></div>
    </div>
        <span class="badge-premium" style="background:var(--gradient-main);color:#fff;padding:0.5rem 1rem;font-size:0.85rem;">
            <i class="bi bi-graph-up me-1"></i> User Summary
        </span>
                </div>
            </div>
        </div>

    <!-- Stat Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-purple">
                <i class="bi bi-file-earmark-text stat-icon"></i>
                <div class="stat-label">Total Notes</div>
                <div class="stat-value">@Model.TotalNotes</div>
                </div>
            </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-green">
                <i class="bi bi-download stat-icon"></i>
                <div class="stat-label">Total Downloads</div>
                <div class="stat-value">@Model.TotalDownloads</div>
        </div>

        <!-- Kurs Kartı -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2 bg-info text-white">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-uppercase mb-1">TotalComments</div>
                    <div class="h5 mb-0 font-weight-bold">@Model.TotalComments</div>
                </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-blue">
                <i class="bi bi-chat-dots stat-icon"></i>
                <div class="stat-label">Total Comments</div>
                <div class="stat-value">@Model.TotalComments</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-orange">
                <i class="bi bi-check-circle stat-icon"></i>
                <div class="stat-label">Approved Notes</div>
                <div class="stat-value">@Model.ApprovedNotes</div>
                </div>
            </div>
        </div>
    </div>
</div>

    <!-- My Notes -->
    <h3 class="section-title"><i class="bi bi-journal-text me-2"></i>My Notes</h3>
    <div class="divider"></div>


<h3 class="mb-3">My Notes</h3>

@if (!Model.MyNotes.Any())
{
        <div class="empty-state">
            <i class="bi bi-journal-x"></i>
            <h5>You have not uploaded any notes yet.</h5>
            <p>Start sharing your knowledge!</p>
    </div>
}
else
{
        <div class="row g-4 mb-5">
        @foreach (var note in Model.MyNotes)
        {
                <div class="col-md-6">
                    <div class="card-premium h-100">
                    <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-file-earmark-text me-2" style="color:var(--primary);"></i>@note.Title
                            </h5>
                            <p class="card-text">@note.Description</p>
                        @if (note.Course != null)
                        {
                                <span class="badge-premium badge-approved mb-2 d-inline-block">
                                    <i class="bi bi-book me-1"></i> @note.Course.CourseName
                                </span>
                        }
                            <div class="d-flex flex-wrap gap-3 mt-2" style="font-size:0.85rem;">
                                <span class="text-muted"><i class="bi bi-calendar3 me-1"></i> @note.UploadDate.ToShortDateString()</span>
                                <span class="text-muted"><i class="bi bi-download me-1"></i> @note.DownloadCount</span>
                            </div>
                            <div class="mt-2">
                            @if (note.Status == NoteStatus.Pending)
                            {
                                    <span class="badge-premium badge-pending"><i class="bi bi-hourglass me-1"></i> Pending</span>
                            }
                            else if (note.Status == NoteStatus.Approved)
                            {
                                    <span class="badge-premium badge-approved"><i class="bi bi-check-circle me-1"></i> Approved</span>
                            }
                            else if (note.Status == NoteStatus.Rejected)
                            {
                                    <span class="badge-premium badge-rejected"><i class="bi bi-x-circle me-1"></i> Rejected</span>
                            }
                            </div>
                    </div>
                        <div class="card-footer d-flex flex-wrap gap-2">
                            <a asp-controller="Notes" asp-action="Details" asp-route-id="@note.Id" class="btn btn-gradient btn-sm">
                                <i class="bi bi-eye me-1"></i> Details
                        </a>
                            <a asp-controller="Notes" asp-action="Download" asp-route-id="@note.Id" class="btn btn-success-premium btn-sm">
                                <i class="bi bi-download me-1"></i> Download
                        </a>
                            <a asp-controller="Notes" asp-action="Edit" asp-route-id="@note.Id" class="btn btn-warning-premium btn-sm">
                                <i class="bi bi-pencil me-1"></i> Edit
                        </a>
                            <a asp-controller="Notes" asp-action="Delete" asp-route-id="@note.Id" class="btn btn-danger-premium btn-sm">
                                <i class="bi bi-trash me-1"></i> Delete
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
}

    <!-- My Comments -->
    <h3 class="section-title"><i class="bi bi-chat-dots me-2"></i>My Comments</h3>
    <div class="divider"></div>

@if (!Model.MyComments.Any())
{
        <div class="empty-state">
            <i class="bi bi-chat-square-dots"></i>
            <h5>You have not written any comments yet.</h5>
    </div>
}
else
{
    <div class="row">

        @foreach (var comment in Model.MyComments)
        {
            <div class="comment-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-file-earmark-text me-1" style="color:var(--primary);"></i> @comment.Note.Title</h6>
                    <small class="text-muted">@comment.CreatedAt.ToString("g")</small>
                    </div>
                <p class="text-muted mb-2">@comment.Content</p>
                <a asp-controller="Notes" asp-action="Details" asp-route-id="@comment.NoteId" class="btn btn-gradient btn-sm">
                    <i class="bi bi-arrow-right me-1"></i> Go To Note
                        </a>

                    </div>

                </div>

            </div>
        }
    }
    </div>
}