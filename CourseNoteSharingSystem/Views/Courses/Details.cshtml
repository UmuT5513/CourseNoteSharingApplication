

@{
    ViewData["Title"] = "Details";
}

@model Course

<h1>@Model.CourseCode</h1>

<h3>@Model.CourseName</h3>

<hr />

<h4>Notes</h4>

@if(!Model.Notes.Any())
{
    <div class="alert alert-warning">
        No notes yet.
    </div>
}

@foreach(var note in Model.Notes)
{
    <div class="card mb-3 p-3">

        <h5>@note.Title</h5>

        <p>@note.Description</p>

        <p>
            Uploaded By:
            @note.User.UserName
        </p>

        <a asp-controller="Note"
           asp-action="Details"
           asp-route-id="@note.Id"
           class="btn btn-primary btn-sm">

            View Note

        </a>

    </div>
}