@{
    ViewData["Title"] = "Course Details";
    Layout = "_Layout";
}
@model Course

<div class="container page-container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card-premium mb-4 fade-in">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div style="width:50px;height:50px;border-radius:var(--radius-md);background:var(--gradient-main);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.3rem;margin-right:1rem;">
                            <i class="bi bi-book"></i>
                        </div>
                        <div>
                            <h2 class="mb-0 fw-bold">@Model.CourseCode</h2>
                            <span class="text-muted">@Model.CourseName</span>
                        </div>
                    </div>
                </div>
            </div>

            <h3 class="section-title"><i class="bi bi-file-earmark-text me-2"></i>Notes</h3>
            <div class="divider"></div>

            @if (!Model.Notes.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-journal-x"></i>
                    <h5>No notes yet</h5>
                    <p>Be the first to upload a note for this course!</p>
                </div>
            }

            @foreach (var note in Model.Notes)
            {
                <div class="card-premium mb-3">
                    <div class="card-body">
                        <h5 class="fw-bold"><i class="bi bi-file-earmark-text me-2" style="color:var(--primary);"></i>@note.Title</h5>
                        <p class="text-muted mb-2">@note.Description</p>
                        <span class="badge bg-light text-dark" style="border-radius:50px;font-size:0.78rem;">
                            <i class="bi bi-person me-1"></i> @note.User.UserName
                        </span>
                    </div>
                    <div class="card-footer">
                        <a asp-controller="Notes" asp-action="Details" asp-route-id="@note.Id" class="btn btn-gradient btn-sm">
                            <i class="bi bi-eye me-1"></i> View Note
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>