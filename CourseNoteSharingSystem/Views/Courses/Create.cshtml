@model CourseNoteSharingSystem.Models.Course

@{
    ViewData["Title"] = "Create Course";
    Layout = "_Layout";
}

<div class="container page-container">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="form-card fade-in">
                <div class="text-center mb-4">
                    <div class="auth-icon mx-auto" style="width:60px;height:60px;font-size:1.4rem;background:linear-gradient(135deg, #00b894, #00cec9);">
                        <i class="bi bi-plus-circle"></i>
                    </div>
                    <h2 class="mt-3 text-gradient">Create Course</h2>
                    <p class="text-muted">Add a new course to the system</p>
                </div>

<h4>Course</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="CourseName" class="form-label"><i class="bi bi-book me-1"></i> Course Name</label>
                        <input asp-for="CourseName" class="form-control" placeholder="e.g. Data Structures" />
                        <span asp-validation-for="CourseName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CourseCode" class="form-label"><i class="bi bi-hash me-1"></i> Course Code</label>
                        <input asp-for="CourseCode" class="form-control" placeholder="e.g. CS201" />
                        <span asp-validation-for="CourseCode" class="text-danger small"></span>
            </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"><i class="bi bi-text-paragraph me-1"></i> Description</label>
                        <input asp-for="Description" class="form-control" placeholder="Brief description" />
                        <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
                    <div class="mb-4">
                        <label asp-for="Department" class="form-label"><i class="bi bi-building me-1"></i> Department</label>
                        <input asp-for="Department" class="form-control" placeholder="e.g. Computer Science" />
                        <span asp-validation-for="Department" class="text-danger small"></span>
            </div>
                    <button type="submit" class="btn btn-success-premium w-100 py-2" style="border-radius:var(--radius-sm);">
                        <i class="bi bi-check-circle me-2"></i> Create
                    </button>
                </form>
                <div class="text-center mt-3">
                    <a asp-action="Index" class="text-muted small"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
