@{
    ViewData["Title"] = "Courses";
    Layout = "_Layout";
}
@model IEnumerable<Course>

<div class="container page-container">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h1 class="section-title mb-1"><i class="bi bi-book me-2 text-gradient"></i>Courses</h1>
            <div class="divider"></div>
        </div>
        <a asp-action="Create" class="btn btn-gradient">
            <i class="bi bi-plus-circle me-2"></i> Add Course
        </a>
    </div>

    <form method="get" class="search-bar">
        <div class="row g-3 align-items-center">
            <div class="col-md-6">
                <input type="text" name="search" value="@Context.Request.Query["search"]"
                       class="form-control" placeholder="🔍 Search courses..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-gradient w-100">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </div>
        </div>
    </form>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card-premium h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div style="width:45px;height:45px;border-radius:var(--radius-md);background:var(--gradient-main);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.1rem;margin-right:0.8rem;">
                                <i class="bi bi-book"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold">@item.CourseCode</h5>
                                <small class="text-muted">@item.CourseName</small>
                            </div>
                        </div>
                        <span class="badge bg-light text-dark" style="border-radius:50px;font-size:0.8rem;">
                            <i class="bi bi-file-earmark me-1"></i> @(item.Notes?.Count ?? 0) Notes
                        </span>
                    </div>
                    <div class="card-footer d-flex flex-wrap gap-2">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-gradient btn-sm">
                            <i class="bi bi-eye me-1"></i> Details
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning-premium btn-sm">
                            <i class="bi bi-pencil me-1"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger-premium btn-sm">
                            <i class="bi bi-trash me-1"></i> Delete
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>