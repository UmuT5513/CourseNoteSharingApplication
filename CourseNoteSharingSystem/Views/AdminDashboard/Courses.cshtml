@{
    Layout = "_Layout";
}

@model List<Course>


<h2> Course List</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Course Name</th>
            <th>Course Code</th>
            <th>Department</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.CourseName</td>
                <td>@course.CourseCode</td>
                <td>@course.Department</td>
                <td>@course.Description</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
