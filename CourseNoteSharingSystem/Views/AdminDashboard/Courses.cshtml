@{
    Layout = "_Layout";
    ViewData["Title"] = "Courses";
}

@model List<Course>

<div class="container page-container">
    <h1 class="section-title"><i class="bi bi-book me-2 text-gradient"></i>Course List</h1>
    <div class="divider"></div>

    <div class="table-premium">
        <table class="table mb-0">
    <thead>
        <tr>
                    <th><i class="bi bi-book me-1"></i> Course Name</th>
                    <th><i class="bi bi-hash me-1"></i> Course Code</th>
                    <th><i class="bi bi-building me-1"></i> Department</th>
                    <th><i class="bi bi-text-paragraph me-1"></i> Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                        <td><strong>@course.CourseName</strong></td>
                <td>@course.CourseCode</td>
                <td>@course.Department</td>
                <td>@course.Description</td>
                <td>
                            <a asp-controller="Courses" asp-action="Edit" asp-route-id="@course.Id" class="btn btn-gradient btn-sm">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                            <a asp-controller="Courses" asp-action="Delete" asp-route-id="@course.Id" class="btn btn-danger-premium btn-sm">
                                <i class="bi bi-trash me-1"></i> Delete
                            </a>
                </td>
            </tr>
        }
    </tbody>
</table>
    </div>
</div>
