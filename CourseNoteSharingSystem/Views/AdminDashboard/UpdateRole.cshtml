@{
    Layout = "_Layout";
    ViewData["Title"] = "Update Role";
}
@model Role

<div class="container page-container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-card fade-in">
                <div class="text-center mb-4">
                    <div class="auth-icon mx-auto" style="width:60px;height:60px;font-size:1.4rem;background:linear-gradient(135deg, #fdcb6e, #f39c12);">
                        <i class="bi bi-shield-exclamation"></i>
                    </div>
                    <h2 class="mt-3 text-gradient">Update Role</h2>
                </div>

                <form asp-action="UpdateRole" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-4">
                        <label class="form-label"><i class="bi bi-shield me-1"></i> Role Name</label>
                        <input type="text" class="form-control" name="roleName" value="@Model.Name" />
                    </div>
                    <button type="submit" class="btn btn-warning-premium w-100 py-2" style="border-radius:var(--radius-sm);">
                        <i class="bi bi-check-circle me-2"></i> Update
                    </button>
                </form>
                <div class="text-center mt-3">
                    <a asp-action="Roles" class="text-muted small"><i class="bi bi-arrow-left me-1"></i> Cancel</a>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mt-3" style="border-radius:var(--radius-md);">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p class="mb-0">@error.ErrorMessage</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>