@{
    Layout = "_Layout";
}

@model List<Role>

<h2>Role List</h2>

<a asp-action="AddRole" class="btn btn-success mb-3">Add new role</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Role Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>
                    <a asp-action="UpdateRole" asp-route-id="@role.Id" class="btn btn-sm btn-primary">Update</a>
                    <a asp-action="DeleteRole" asp-route-id="@role.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
