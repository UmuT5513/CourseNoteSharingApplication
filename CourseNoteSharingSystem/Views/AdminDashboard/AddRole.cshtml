@{
    Layout = "_Layout";
    ViewData["Title"] = "Add Role";
}

<div class="container page-container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-card fade-in">
                <div class="text-center mb-4">
                    <div class="auth-icon mx-auto" style="width:60px;height:60px;font-size:1.4rem;background:linear-gradient(135deg, #00b894, #00cec9);">
                        <i class="bi bi-shield-plus"></i>
                    </div>
                    <h2 class="mt-3 text-gradient">Add Role</h2>
                </div>

                <form asp-action="AddRole" method="post">
                    <div class="mb-4">
                        <label for="roleName" class="form-label"><i class="bi bi-shield me-1"></i> Role Name</label>
                        <input type="text" class="form-control" name="roleName" required placeholder="Enter role name" />
                    </div>
                    <button type="submit" class="btn btn-success-premium w-100 py-2" style="border-radius:var(--radius-sm);">
                        <i class="bi bi-plus-circle me-2"></i> Add
                    </button>
                </form>
                <div class="text-center mt-3">
                    <a asp-action="Roles" class="text-muted small"><i class="bi bi-arrow-left me-1"></i> Back to Roles</a>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mt-3" style="border-radius:var(--radius-md);">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p class="mb-0">@error.ErrorMessage</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
