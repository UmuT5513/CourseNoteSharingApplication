@model IEnumerable<CourseNoteSharingSystem.Models.Note>

@{
    ViewData["Title"] = "Manage Notes";
}

<div class="container page-container">
    <div class="page-header mb-4">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h1 class="mb-1">Manage Notes</h1>
                <p class="mb-0">Review, approve, or reject shared notes.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Notes" class="btn btn-outline-premium">All</a>
                <a asp-action="Notes" asp-route-status="Pending" class="btn btn-warning-premium">Pending</a>
                <a asp-action="Notes" asp-route-status="Approved" class="btn btn-success-premium">Approved</a>
                <a asp-action="Notes" asp-route-status="Rejected" class="btn btn-danger-premium">Rejected</a>
            </div>
        </div>
    </div>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        No notes found.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-md-6">

                <div class="card-premium h-100">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start gap-2">

                            <h4 class="card-title mb-0">
                                @item.Title
                            </h4>

                            @if (item.Status == NoteStatus.Pending)
                            {
                                <span class="badge badge-premium badge-pending">
                                    Pending
                                </span>
                            }
                            else if (item.Status == NoteStatus.Approved)
                            {
                                <span class="badge badge-premium badge-approved">
                                    Approved
                                </span>
                            }
                            else if (item.Status == NoteStatus.Rejected)
                            {
                                <span class="badge badge-premium badge-rejected">
                                    Rejected
                                </span>
                            }

                        </div>

                        <hr />

                        <p>
                            @item.Description
                        </p>

                        <p>
                            <strong>Course:</strong>
                            @(item.Course?.CourseName)
                        </p>

                        <p>
                            <strong>Uploaded By:</strong>
                            @(item.User?.UserName)
                        </p>

                        <p>
                            <strong>Upload Date:</strong>
                            @item.UploadDate.ToShortDateString()
                        </p>

                        <p>
                            <strong>Downloads:</strong>
                            @item.DownloadCount
                        </p>

                    </div>

                    <div class="card-footer d-flex gap-2 flex-wrap">

                        <a asp-controller="Notes"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-gradient btn-sm">

                            Details

                        </a>

                        <a asp-controller="Notes"
                           asp-action="Download"
                           asp-route-id="@item.Id"
                           class="btn btn-success-premium btn-sm">

                            Download

                        </a>

                        <a asp-controller="Notes"
                           asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning-premium btn-sm">

                            Edit

                        </a>

                        <a asp-controller="Notes"
                           asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger-premium btn-sm">

                            Delete

                        </a>

                        @if (item.Status == NoteStatus.Pending)
                        {
                            <form asp-action="Approve"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="btn btn-success-premium btn-sm">

                                    Approve

                                </button>

                            </form>

                            <form asp-action="Reject"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="btn btn-danger-premium btn-sm">

                                    Reject

                                </button>

                            </form>
                        }

                    </div>

                </div>

            </div>
        }

    </div>
}