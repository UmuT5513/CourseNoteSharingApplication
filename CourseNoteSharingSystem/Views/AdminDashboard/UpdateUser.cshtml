@{
    Layout = "_Layout";
}

@model UpdateUserViewModel

<h2>Update User</h2>

<form asp-actions="UpdateUser" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    
    <div class="form-group">
        <label asp-for="UserName"></label>
        <input asp-for="UserName" class="form-control" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="BirthDate"></label>
        <input asp-for="BirthDate" class="form-control" />
        <span asp-validation-for="BirthDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Roller</label>
        <div>
            @for(int i = 0; i < Model.Roles.Count; i++)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="Roles[@i].IsSelected"/>
                        <label class="form-check-label" >@Model.Roles[i].RoleName</label>
                        <input type="hidden" asp-for="Roles[@i].RoleName"/>
                    </div>
                }
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Users" class="btn btn-secondary">Cancel</a>
</form>
