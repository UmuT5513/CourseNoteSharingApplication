@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="dashboard-hero glass-card">
    <div>
        <span class="eyebrow">Admin dashboard</span>
        <h1>System overview</h1>
        <p class="text-muted mb-0">Manage users, roles, courses and pending note approvals from one workspace.</p>
    </div>
    <a asp-action="PendingNotes" asp-controller="AdminDashboard" class="btn btn-primary btn-lg"><i class="bi bi-hourglass-split me-2"></i>Review pending</a>
</section>

<div class="stat-grid">
    <div class="stat-card"><div class="icon"><i class="bi bi-people"></i></div><span>Total users</span><strong>@Model.TotalUsers</strong></div>
    <div class="stat-card"><div class="icon"><i class="bi bi-shield-lock"></i></div><span>Total roles</span><strong>@Model.TotalRoles</strong></div>
    <div class="stat-card"><div class="icon"><i class="bi bi-mortarboard"></i></div><span>Total courses</span><strong>@Model.TotalCourses</strong></div>
    <div class="stat-card"><div class="icon"><i class="bi bi-file-earmark-text"></i></div><span>Total notes</span><strong>@Model.TotalNotes</strong></div>
</div>

<div class="dashboard-grid">
    <section class="panel soft-card">
        <div class="panel-header">
            <h2 class="h5 fw-bold mb-0">User management</h2>
            <a asp-action="Users" asp-controller="AdminDashboard" class="btn btn-ghost btn-sm">All users</a>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Email</th><th>Username</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var user in Model.RecentUsers)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td><strong>@user.UserName</strong></td>
                            <td><span class="badge text-bg-success">Active</span></td>
                            <td><a asp-action="UpdateUser" asp-route-id="@user.Id" class="btn btn-ghost btn-sm">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <aside class="d-grid gap-3">
        <section class="panel soft-card">
            <div class="panel-header"><h2 class="h5 fw-bold mb-0">System chart</h2></div>
            <div class="mini-chart">
                <span style="height: 88%"></span><span style="height: 42%"></span><span style="height: 65%"></span><span style="height: 76%"></span><span style="height: 54%"></span>
            </div>
        </section>
        <section class="panel soft-card">
            <div class="panel-header"><h2 class="h5 fw-bold mb-0">Admin tools</h2></div>
            <div class="quick-actions">
                <a class="quick-action" asp-action="Users"><i class="bi bi-people d-block mb-2"></i>Users</a>
                <a class="quick-action" asp-action="Roles"><i class="bi bi-shield d-block mb-2"></i>Roles</a>
                <a class="quick-action" asp-action="Courses"><i class="bi bi-collection d-block mb-2"></i>Courses</a>
                <a class="quick-action" asp-action="Notes"><i class="bi bi-file-text d-block mb-2"></i>Notes</a>
            </div>
        </section>
    </aside>
</div>

<div class="dashboard-grid mt-3">
    <section class="panel soft-card">
        <div class="panel-header">
            <h2 class="h5 fw-bold mb-0">Pending notes approval</h2>
            <a asp-controller="Notes" asp-action="PendingNotes" class="btn btn-primary btn-sm">Open queue</a>
        </div>
        <div class="empty-state">
            <div>
                <i class="bi bi-hourglass-split"></i>
                <h3 class="h5 mt-3">Approval queue</h3>
                <p class="mb-0">Use the pending notes panel to approve new submissions.</p>
            </div>
        </div>
    </section>
    <section class="panel soft-card">
        <div class="panel-header"><h2 class="h5 fw-bold mb-0">Recent activities</h2></div>
        <div class="activity-item"><i class="bi bi-person-plus text-primary"></i><div><strong>New student account</strong><p class="text-muted mb-0">Recent registrations are listed in the user table.</p></div></div>
        <div class="activity-item"><i class="bi bi-file-check text-primary"></i><div><strong>Notes require review</strong><p class="text-muted mb-0">Pending uploads should be checked before approval.</p></div></div>
        <div class="activity-item"><i class="bi bi-shield-check text-primary"></i><div><strong>Role management</strong><p class="text-muted mb-0">Admin and User roles are available.</p></div></div>
    </section>
</div>
