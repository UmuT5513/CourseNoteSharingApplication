@using CourseNoteSharingSystem.ViewModels

@model AdminDashboardViewModel

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2>Yönetim Paneli</h2>
        <span class="badge bg-dark">Sistem Özeti</span>
    </div>
    <hr />

    <div class="row">
        <!-- Kullanıcı Kartı -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2 bg-primary text-white">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-uppercase mb-1">Toplam Kullanıcı</div>
                    <div class="h5 mb-0 font-weight-bold">@Model.TotalUsers</div>
                </div>
            </div>
        </div>

        <!-- Rol Kartı -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2 bg-success text-white">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-uppercase mb-1">Toplam Rol</div>
                    <div class="h5 mb-0 font-weight-bold">@Model.TotalRoles</div>
                </div>
            </div>
        </div>

        <!-- Kurs Kartı -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2 bg-info text-white">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-uppercase mb-1">Toplam Kurs</div>
                    <div class="h5 mb-0 font-weight-bold">@Model.TotalCourses</div>
                </div>
            </div>
        </div>

        <!-- Not Kartı -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2 bg-danger text-white">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-uppercase mb-1">Toplam Not</div>
                    <div class="h5 mb-0 font-weight-bold">@Model.TotalNotes</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Son Kullanıcılar Listesi -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-light">
            <h6 class="m-0 font-weight-bold text-primary">Son Kayıt Olanlar</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>E-Posta</th>
                            <th>Kullanıcı Adı</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.RecentUsers)
                        {
                            <tr>
                                <td>@user.Email</td>
                                <td>@user.UserName</td>
                                <td><span class="badge bg-success">Aktif</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div>
        <a asp-action="Users" asp-controller="AdminDashboard" class="btn btn-primary">List Users</a>
        <a asp-action="Roles" asp-controller="AdminDashboard" class="btn btn-secondary">List Roles</a>
        <a asp-action="Courses" asp-controller="AdminDashboard" class="btn btn-success">List Courses</a>
        <a asp-action="Notes" asp-controller="AdminDashboard" class="btn btn-info">All Notes</a>
        <a asp-action="PendingNotes" asp-controller="AdminDashboard" class="btn btn-info">Pending Notes</a>
    </div>
</div>